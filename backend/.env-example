# local postgres, or the External Database URL from your host's dashboard.
# postgresql:// and postgres:// are both accepted -- config.py rewrites them to psycopg3.
# hosted databases usually need ?sslmode=require on the end.
DATABASE_URL = postgresql+psycopg://user:password@localhost:5432/quizdb
SESSION_SECRET = your-session-secret

# comma separated. add the deployed frontend's origin here -- CORS with credentials
# cannot use a wildcard, so each one has to be listed.
ALLOWED_ORIGINS = http://localhost:5173

# set these to none/true once the frontend is on a different origin than the api,
# otherwise the browser drops the session cookie on cross-site requests.
COOKIE_SAMESITE = lax
COOKIE_SECURE = false
